<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/electron_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.66" />
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/electron_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIBRARY"
                android:textColor="@color/electron_accent_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Instances"
                android:textColor="@color/primary_text"
                android:textSize="27sp"
                android:textStyle="bold"
                android:fontFamily="sans" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your Minecraft profiles, all in one place."
                android:textColor="@color/electron_text_muted"
                android:textSize="11sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/electron_panel_background"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INSTANCE"
                    android:textColor="@color/electron_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Your selected instance"
                    android:textColor="@color/primary_text"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap to browse your instance library."
                    android:textColor="@color/electron_text_muted"
                    android:textSize="10sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.kdt.mcgui.mcVersionSpinner
                        android:id="@+id/mc_version_spinner"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/electron_field_background"
                        android:drawableEnd="@drawable/spinner_arrow"
                        android:textColor="@color/primary_text"
                        android:textSize="12sp"
                        app:drawableEndPadding="7dp"
                        app:drawableEndSize="15dp"
                        app:drawableStartIntegerScaling="true"
                        app:drawableStartSize="32dp" />
                    <ImageButton
                        android:id="@+id/edit_profile_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/electron_action_background"
                        android:contentDescription="Manage selected instance"
                        android:padding="12dp"
                        android:src="@drawable/ic_edit_profile"
                        android:tint="@color/primary_text" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="MODS &amp; CONTENT"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/modrinth_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:drawableStart="@drawable/ic_modrinth"
                android:text="Browse Modrinth mods" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="QUICK TOOLS"
                android:textColor="@color/electron_text_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/news_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_news"
                    android:text="@string/mcl_tab_wiki" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/discord_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_discord"
                    android:text="@string/mcl_button_discord" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/custom_control_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_custom_controls"
                    android:text="Controls" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/install_jar_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_install_jar"
                    android:text="Install mod" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/share_logs_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@android:drawable/ic_menu_share"
                    android:text="Share logs" />
                <com.kdt.mcgui.LauncherMenuButton
                    android:id="@+id/open_files_button"
                    style="@style/LauncherMenuButton.Universal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_folder"
                    android:text="Game files" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/electron_launch_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/electron_panel_background"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintStart_toStartOf="@id/electron_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY TO PLAY"
            android:textColor="@color/electron_accent_blue"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Your game.\nYour setup."
            android:textColor="@color/primary_text"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="sans" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="18dp"
            android:background="@color/divider" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAUNCH INSTANCE"
            android:textColor="@color/electron_text_muted"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/electron_play_background"
            android:text="Launch"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            android:letterSpacing="0.1" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Instance"
            android:textColor="@color/electron_text_muted"
            android:textSize="10sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="ELECTRON  •  JAVA EDITION"
            android:textColor="@color/electron_text_muted"
            android:textSize="9sp"
            android:letterSpacing="0.08" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>